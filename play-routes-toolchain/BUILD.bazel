load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//scala:version.bzl", "scala_2_13_version", "scala_3_version")
load(":create-toolchain.bzl", "create_play_routes_toolchain")

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

create_play_routes_toolchain(
    name = "play-routes-3",
    play_routes_compiler = "//play-routes-compiler-cli:play-routes-compiler-cli-3",
    scala_version = scala_3_version,
)

create_play_routes_toolchain(
    name = "play-routes-2-13",
    play_routes_compiler = "//play-routes-compiler-cli:play-routes-compiler-cli-2-13",
    scala_version = scala_2_13_version,
)

# For Play 2.7 consumers to register ahead of play-routes-2-13; it matches every 2.13 target.
create_play_routes_toolchain(
    name = "play-routes-2-13-play-2-7",
    play_routes_compiler = "//play-routes-compiler-cli:play-routes-compiler-cli-2-13-play-2-7",
    scala_version = scala_2_13_version,
)

# Registered by this module so its tests can select the Play 2.7 compiler with
# scala_version = "play-2-7_2.13" without shadowing play-routes-2-13.
create_play_routes_toolchain(
    name = "play-routes-2-13-play-2-7-prefixed",
    play_routes_compiler = "//play-routes-compiler-cli:play-routes-compiler-cli-2-13-play-2-7",
    prefix = "play-2-7",
    scala_version = scala_2_13_version,
)

bzl_library(
    name = "bzl",
    srcs = glob(["*.bzl"]),
    visibility = ["//visibility:public"],
    deps = ["@rules_scala_annex//rules:scala-rules"],
)
